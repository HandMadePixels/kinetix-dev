										"key": "Authorization",
										"value": "Bearer {{access_token}}",
										"type": "text"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"device_id\": \"{{device_uuid}}\",\n    \"command_type\": \"shell\",\n    \"payload\": \"dir C:\\ \"\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
