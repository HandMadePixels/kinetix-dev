								"key": "Authorization",
								"value": "Bearer {{agent_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"push_id\": 1,\n    \"status\": \"completed\",\n    \"error_message\": \"\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/update-status/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"update-status",
								""
							]
						}
					}
				}
			]
		},
		{
			"name": "Dashboard / Admin",
			"item": [
				{
					"name": "Updates",
					"item": [
						{
							"name": "Upload Update",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Authorization",
										"value": "Bearer {{access_token}}",
										"type": "text"
									}
								],
								"body": {
								"mode": "formdata",
								"formdata": [
									{
										"key": "file",
										"type": "file",
										"src": []
									},
									{
										"key": "version",
										"value": "2.0.0",
										"type": "text"
									},
									{
										"key": "description",
										"value": "Security Patch",
										"type": "text"
									}
								]
								},
							"url": {
								"raw": "{{base_url}}/api/v1/updates/",
								"host": [
									"{{base_url}}"
								],
								"path": [
									"api",
									"v1",
									"updates",
									""
							]
							}
						}
						},
						{
							"name": "Deploy Update (Push)",
							"request": {
