											"type": "text"
										}
									],
									"url": {
										"raw": "{{base_url}}/api/v1/commands-history/?device={{device_uuid}}",
										"host": [
											"{{base_url}}"
										],
										"path": [
											"api",
											"v1",
											"commands-history",
											""
										],
										"query": [
											{
												"key": "device",
												"value": "{{device_uuid}}"
											}
										]
									}
								}
							}
					]
