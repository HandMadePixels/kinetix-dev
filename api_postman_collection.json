										"key": "Authorization",
										"value": "Bearer {{access_token}}",
										"type": "text"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"update_id\": \"UPDATE_UUID_HERE\",\n    \"target_hostnames\": [\"{{hostname}}\"],\n    \"push_to_all\": false,\n    \"scheduled_at\": \"2026-01-28T10:00:00Z\"\n}",
								"options": {
									"raw": {
										"language": "json"
									}
								}
							},
							"url": {
								"raw": "{{base_url}}/api/v1/push-update/",
								"host": [
									"{{base_url}}"
								],
								"path": [
									"api",
									"v1",
									"push-update",
									""
							]
							}
						}
						},
						{
							"name": "Poll Push Status",
							"request": {
								"method": "GET",
								"header": [
									{
										"key": "Authorization",
										"value": "Bearer {{access_token}}",
										"type": "text"
									}
								],
								"url": {
									"raw": "{{base_url}}/api/v1/push-status/?ids=1",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"v1",
										"push-status",
										""
									],
									"query": [
										{
											"key": "ids",
											"value": "1"
										}
									]
								}
							}
							},
							{
								"name": "Retry Push",
								"request": {
									"method": "POST",
									"header": [
										{
											"key": "Authorization",
											"value": "Bearer {{access_token}}",
											"type": "text"
										}
									],
									"url": {
										"raw": "{{base_url}}/api/v1/pushes/1/retry/",
										"host": [
											"{{base_url}}"
										],
										"path": [
											"api",
											"v1",
											"pushes",
											"1",
											"retry",
											""
										]
									}
							}
						}
					]
